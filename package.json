{
  "name": "@kmamal/gl",
  "version": "10.0.0-1",
  "description": "Fork of `gl` that can render to windows",
  "main": "./index.js",
  "browser": "./src/javascript/browser-index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./src/javascript/browser-index.js",
      "default": "./index.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "install": "cd scripts && node install.mjs",
    "download-release": "cd scripts && node download-release.mjs",
    "download-deps": "cd scripts && node download-deps.mjs",
    "build": "cd scripts && node build.mjs",
    "upload-release": "cd scripts && node upload-release.mjs",
    "release": "cd scripts && node release.mjs",
    "clean": "cd scripts && node clean.mjs",
    "test": "tape test/*.js"
  },
  "dependencies": {
    "bit-twiddle": "1.0.2",
    "glsl-tokenizer": "2.1.5",
    "modern-tar": "0.8.4"
  },
  "devDependencies": {
    "@stackgl/gl-conformance": "2.1.3",
    "nan": "2.27.0",
    "node-gyp": "12.3.0",
    "tape": "5.10.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kmamal/headless-gl.git"
  },
  "keywords": [
    "webgl",
    "opengl",
    "gl",
    "headless",
    "server",
    "gpgpu"
  ],
  "author": "Mikola Lysenko",
  "license": "BSD-2-Clause",
  "gypfile": true
}
